# =====================================================================
# XMR-Forecast :: variables de entorno
# Copiar a .env y completar. NUNCA subir .env al repositorio (R-14).
# Ningun archivo versionado contiene credenciales reales.
# =====================================================================

# ------------------------------------------------------------------ general
NODE_ENV=development
TZ=UTC

# ------------------------------------------------------------------ secretos
# Generar con: openssl rand -base64 64   (minimo 64 bytes para HS512)
# Si se deja vacio, el backend NO arranca: es intencionado.
JWT_SECRET=
JWT_ISSUER=https://localhost:8443
JWT_AUDIENCE=xmr-forecast-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --------------------------------------------------------------- postgres
# R-27: base de datos y Redis viven en red privada, sin puertos publicados.
POSTGRES_DB=xmr_forecast
POSTGRES_USER=xmr
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://postgres:5432/xmr_forecast
DB_USERNAME=xmr
DB_PASSWORD=
DB_POOL_SIZE=20

# ------------------------------------------------------------------- redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_SSL_ENABLED=false

# ------------------------------------------------------- google oauth 2.0
# Obtenidos en https://console.cloud.google.com/apis/credentials
# La URI de redireccion debe coincidir EXACTAMENTE con la registrada en Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:8443/api/v1/auth/google/callback
FRONTEND_OAUTH_CALLBACK=https://localhost:3000/auth/callback

# --------------------------------------------------------- servicio ml
ML_SERVICE_URL=https://ml-service:8443
ML_SSL_CERTFILE=/certs/ml-service/cert.pem
ML_SSL_KEYFILE=/certs/ml-service/key.pem
ML_SSL_CAFILE=/certs/ca/ca.crt
ML_CONNECT_TIMEOUT_MS=3000
ML_READ_TIMEOUT_MS=60000
ML_MAX_RETRIES=2
# No existe bandera para desactivar la verificacion TLS. La CA de desarrollo se
# anade al truststore del proceso (JAVA_OPTS en docker-compose.yml). Ver docs/02.

# --------------------------------------------------------------- mlflow
MLFLOW_TRACKING_URI=https://mlflow:5000
MLFLOW_SSL_CERTFILE=/certs/mlflow/cert.pem
MLFLOW_SSL_KEYFILE=/certs/mlflow/key.pem

# ------------------------------------------------------------------ tls
# Contrasena del keystore PKCS12 generado por generate-dev-certs.sh.
SERVER_SSL_KEYSTORE_PASSWORD=changeit
SERVER_SSL_KEY_ALIAS=backend

# ------------------------------------------------------------------ cors
# Solo origenes HTTPS. Sin comodines: allowCredentials=true lo prohibe.
CORS_ALLOWED_ORIGINS=https://localhost:3000

# ------------------------------------------------------------- seguridad
MAX_FAILED_LOGINS=5
LOCK_DURATION_MINUTES=15
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=300

# ------------------------------------------------------------------ correo
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=
FRONTEND_BASE_URL=https://localhost:3000