# .env.example — ml-service de XMR-Forecast
#
# Copiar a .env y ajustar. NUNCA commitear el .env real (R-14).
# Todos los secretos vienen por variable de entorno; este fichero solo
# contiene nombres y valores de ejemplo, sin credenciales.

# --- Identidad del servicio -------------------------------------------------
# Nombre lógico devuelto por GET /health.
ML_SERVICE_NAME=ml-service
# Version expuesta por GET /health.
ML_VERSION=1.0.0
# dev | staging | prod. Determina si TLS es obligatorio (ver abajo).
ML_ENVIRONMENT=dev

# --- Red y TLS (R-33: HTTPS forzado en todos los entornos) ------------------
# Interfaz de escucha dentro del contenedor.
ML_HOST=0.0.0.0
# Puerto TLS. 8443 evita el puerto privilegiado 443.
ML_PORT=8443
# Certificado y clave. OBLIGATORIOS en staging y prod; en Docker van en /certs.
ML_SSL_CERTFILE=/certs/cert.pem
ML_SSL_KEYFILE=/certs/key.pem
# Permite HTTP plano SOLO si ML_ENVIRONMENT=dev. Nunca en staging/prod:
# el servicio lanza error de arranque si se combina con otro entorno.
ML_ALLOW_PLAINTEXT_DEV=true

# --- Correlacion de peticiones ----------------------------------------------
# Cabecera que Spring Boot envia y el servicio devuelve en cada respuesta.
ML_REQUEST_ID_HEADER=X-Request-Id
# Longitud maxima aceptada del identificador (evita inyeccion en logs).
ML_MAX_REQUEST_ID_LENGTH=128

# --- Artefactos y datos ------------------------------------------------------
# Registro JSON de versiones de modelo con su procedencia y checksums.
ML_REGISTRY_PATH=./artifacts/registry.json
# Directorio de bundles serializados (.joblib) y ficheros .sha256.
ML_ARTIFACTS_DIR=./artifacts
# Snapshot CSV de mercado para inferencia en linea (R-18: el servicio no
# descarga datos; los recibe ya validados con checksum).
# Sin esta variable, POST /v1/predict responde 503 MARKET_DATA_UNAVAILABLE.
# ML_DATA_SNAPSHOT=./data/xmr_usd.csv

# --- Tracking con MLflow (degrada con log si no responde) --------------------
# En staging/prod debe ser https:// (R-27, R-33).
ML_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Experimento donde se registran las corridas.
ML_MLFLOW_EXPERIMENT=xmr-forecast
# Timeout de las llamadas a MLflow en segundos (R-32).
ML_MLFLOW_TIMEOUT_SECONDS=5.0
# Permite desactivar el tracking (por ejemplo en tests).
ML_MLFLOW_ENABLED=true

# --- Observabilidad ----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Los logs son JSON estructurado con
# request_id y trace_id; nunca se registran secretos.
ML_LOG_LEVEL=INFO