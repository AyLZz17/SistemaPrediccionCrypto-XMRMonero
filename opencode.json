{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 60000,
      "catalog": 30000,
      "execution": 600000
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@0.0.83"]
      },
      "postgres": {
        "type": "local",
        "command": ["npx", "-y", "postgres-mcp@1.0.4"],
        "disabled": true,
        "environment": {
          "DATABASE_URL": "{env:DATABASE_URL}"
        }
      }
    }
  }
}