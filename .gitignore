# =====================================================================
# XMR-Forecast :: .gitignore
# Los secretos y los datos pesados nunca se versionan (R-14, R-27).
# =====================================================================

# --- secretos -----------------------------------------------------------
.env
.env.*
!.env.example
*.p12
*.jks
*.keystore
certs/
docker/certs/*/
docker/certs/*.pem
docker/certs/*.key
docker/certs/*.p12
docker/certs/*.crt
docker/certs/*.srl

# --- Java / Maven -------------------------------------------------------
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.properties

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / frontend ----------------------------------------------------
node_modules/
dist/
dist-ssr/
coverage/
.vite/
*.local
npm-debug.log*
yarn-error.log*
.eslintcache

# --- datos y artefactos ML (R-28: pesados, y con checksum en su manifiesto)
data/*
!data/.gitkeep
artifacts/
notebooks/**/.ipynb_checkpoints/

# --- backups: contienen datos de usuarios ------------------------------
backups/

# --- editores y SO ------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini

# --- temporales ---------------------------------------------------------
*.log
*.tmp
*.bak
*.orig