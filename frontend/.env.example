# ---------------------------------------------------------------------------
# XMR-Forecast frontend — variables de entorno
#
# R-14: este archivo NO contiene secretos. Todo lo que lleve el prefijo VITE_
# se incrusta en el bundle publico del navegador, asi que nunca debe contener
# credenciales. El validador de `src/config/env.ts` aborta el arranque si
# detecta un nombre de variable con aspecto de secreto.
#
# Copia este fichero a `.env.local` (ignorado por git) y ajusta los valores.
# ---------------------------------------------------------------------------

# Origen https:// del backend Spring Boot (monolito). OBLIGATORIO.
# El frontend NUNCA se conecta a PostgreSQL, Redis, MLflow ni al servicio ML.
# Debe incluir el esquema; la ruta /api/v1 se antepone automaticamente.
VITE_API_BASE_URL=https://api.xmr-forecast.example

# Como se transporta el refresh token.
#   body   -> el backend lo devuelve en el TokenResponse; el frontend lo guarda
#             en sessionStorage (se cierra con la pestana).
#   cookie -> el backend lo fija como cookie httpOnly + Secure + SameSite;
#             el JavaScript nunca lo ve. Recomendado en produccion.
VITE_REFRESH_TOKEN_MODE=cookie

# Tiempo maximo de espera por peticion HTTP en milisegundos (1000..120000).
VITE_REQUEST_TIMEOUT_MS=20000

# Solo desarrollo: rutas de los certificados TLS del servidor de Vite.
# Los ficheros de certificado NO se versionan (ver .gitignore).
# VITE_DEV_HTTPS_CERT=./certs/cert.pem
# VITE_DEV_HTTPS_KEY=./certs/key.pem
